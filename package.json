{
  "name": "kheru",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "scripts": {
    "dev": "make dev-kheru",
    "build": "pnpm --filter kheru build",
    "test": "pnpm --filter kheru test",
    "lint": "pnpm --filter kheru exec tsc --noEmit",
    "typecheck": "pnpm --filter kheru exec tsc --noEmit"
  }
}
